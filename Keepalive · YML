name: Keepalive Supabase - Bogotá Bling

# Llama a /api/keepalive en Vercel cada 6 horas para que el proyecto
# de Supabase de Bogotá Bling no se marque como inactivo y se pause.
#
# Se puede disparar manualmente también desde la pestaña Actions de GitHub.

on:
  schedule:
    - cron: '0 */6 * * *'   # cada 6 horas
  workflow_dispatch:

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping keepalive endpoint
        run: |
          curl -f -s -o /dev/null -w "Status: %{http_code}\n" \
            https://bogotabling.vercel.app/api/keepalive
